{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false
      }
    ],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "alchemy.run.ts",
    "facet-version.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
