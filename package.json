{
  "name": "facet-swap",
  "version": "0.1.0",
  "private": true,
  "description": "Local Alchemy Durable Object facet hot-swap prototype",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "alchemy deploy --stage prod",
    "dev": "alchemy dev --no-input",
    "dev:refresh": "node scripts/deploy.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "vitest run",
    "test:quick": "vitest run --exclude test/facet.test.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "^4.0.5",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "5.20261012.1",
    "@effect/tsgo": "0.53.5",
    "@effect/vitest": "^4.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.11.1 || >=25.1.0"
  }
}
