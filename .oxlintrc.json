{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "effecttsgo"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [".alchemy/**", "audit.json"],
  "overrides": [
    {
      "files": ["src/**/*.ts", "infra/**/*.ts", "alchemy.run.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/scripts", "**/scripts/**", "**/test", "**/test/**"],
                "message": "Runtime and infrastructure must not import CLI entrypoints or tests."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/scripts",
                  "**/scripts/**",
                  "**/test",
                  "**/test/**",
                  "**/infra",
                  "**/infra/**"
                ],
                "message": "Worker runtime cannot import infrastructure, CLI entrypoints or tests."
              },
              {
                "group": ["**/alchemy.run"],
                "allowTypeImports": true,
                "message": "Stack imports must be type-only so infrastructure stays out of Worker bundles."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/**/*.ts"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/valid-expect": "error",
        "vitest/valid-title": "error"
      }
    }
  ],
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error"
  },
  "options": {
    "typeAware": true
  }
}
